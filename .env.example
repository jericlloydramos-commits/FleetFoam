# ------------------------------------------------------------------------------
# SECTION 3.2 & 5.1: POSTGRESQL CONNECTION POOLING (PGBOUNCER / SUPAVISOR)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Connects through transaction-mode connection pooler (Port 6543).
#    Hardware-Bounded Pool Limit Formula: (CPU Cores * 2) + Disk Count = (4 * 2) + 1 = 9-15 connections.
DATABASE_URL="postgresql://postgres.fleetfoam-prod:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# 2. DIRECT_URL: Direct TCP connection (Port 5432) used exclusively for Prisma schema migrations:
#    - npx prisma migrate dev (Local shadow database checks)
#    - npx prisma migrate deploy (Production CI/CD automated pipeline)
DIRECT_URL="postgresql://postgres.fleetfoam-prod:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# SUPABASE CLIENT CREDENTIALS (FRONTEND & RLS AUTHENTICATION)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
