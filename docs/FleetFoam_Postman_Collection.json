    {
      "name": "1. GET Dispatch Queue (200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/jobs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "jobs"]
        },
        "description": "Retrieves the active central dispatch jobs ledger from Supabase and shared server store."
      },
      "response": []
    },
    {
      "name": "2. Check Availability — Open Slot (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-09-25\",\n  \"time_slot\": \"01:00 PM - 03:00 PM\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/bookings/availability",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "bookings", "availability"]
        },
        "description": "Tests availability check for an open slot. Returns HTTP 200 OK with available: true."
      },
      "response": []
    },
    {
      "name": "3. Conflict Detection — Double Booking (409 Conflict / FTC-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-09-14\",\n  \"time_slot\": \"09:30 AM - 11:00 AM\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/bookings/availability",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "bookings", "availability"]
        },
        "description": "Tests double-booking prevention (FTC-01). Requests an already occupied slot on 2026-09-14. Returns HTTP 409 Conflict."
      },
      "response": []
    },
    {
      "name": "4. Missing Parameters Validation (400 Bad Request / FTC-02)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-09-25\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/bookings/availability",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "bookings", "availability"]
        },
        "description": "Tests payload validation (FTC-02). Omits the required time_slot field. Returns HTTP 400 Bad Request."
      },
      "response": []
    },
    {
