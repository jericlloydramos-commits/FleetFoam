          "raw": "{\n  \"service_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"vehicle_make\": \"Toyota\",\n  \"vehicle_model\": \"Fortuner\",\n  \"vehicle_plate\": \"NBC 1234\",\n  \"service_location\": \"Unit 402, Acacia Estates, Taguig City\",\n  \"appointment_date\": \"2026-09-28\",\n  \"time_slot\": \"09:30 AM - 11:00 AM\"\n}"
