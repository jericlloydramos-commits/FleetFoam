          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "bookings"]
        },
        "description": "Creates a new customer booking via Next.js API. Returns HTTP 201 Created."
      },
      "response": []
    },
    {
      "name": "7. Delete Booking via Localhost API (200 OK)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/bookings?id={{booking_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "bookings"],
          "query": [
            {
              "key": "id",
              "value": "{{booking_id}}",
              "description": "Replace with target booking UUID"
            }
          ]
        },
        "description": "Deletes a booking by ID via the local Next.js API route. Returns HTTP 200 OK."
      },
      "response": []
    },
