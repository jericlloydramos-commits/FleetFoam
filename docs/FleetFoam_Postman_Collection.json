      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"RESET_DEMO\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/jobs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "jobs"]
        },
        "description": "Resets the active dispatch queue back to the clean 3-order instructor demonstration state."
      },
      "response": []
    },
    {
      "name": "6. Create Customer Booking (201 Created)",
